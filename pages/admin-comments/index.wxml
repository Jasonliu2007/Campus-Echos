<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}"><view class="content"><view class="page-intro"><view><view class="intro-title">评论审核与处置</view><view class="sub">当前版本核实 · 微信审核先行</view></view></view><view class="row"><button class="chip {{filter === 'pending' ? 'active' : ''}}" bindtap="filter" data-value="pending" hover-class="press" hover-start-time="0" hover-stay-time="120">待审核</button><button class="chip {{filter === 'published' ? 'active' : ''}}" bindtap="filter" data-value="published" hover-class="press" hover-start-time="0" hover-stay-time="120">已公开</button></view><campus-state wx:if="{{loading && !items.length}}" kind="loading" title="正在读取评论"/><view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="refresh" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">刷新并核对</button></view><campus-state wx:if="{{!loading && !items.length && !error}}" title="本列表暂时为空"/>
<view wx:for="{{items}}" wx:key="_id" class="reading-panel"><view class="between"><text class="name">{{item.authorName}}</text><text class="sub">{{item.displayTime}}</text></view><text class="comment-copy" user-select>{{item.content}}</text><view wx:if="{{item.replyToName}}" class="sub">回复 {{item.replyToName}}</view><button class="text-button" data-id="{{item.postId}}" bindtap="open" hover-class="press" hover-start-time="0" hover-stay-time="120">查看所在帖子</button><button class="secondary full" data-id="{{item._id}}" bindtap="choose" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">核对并处理</button><block wx:if="{{reasonFor === item._id}}"><label class="label" for="comment-review-reason">处理说明</label><textarea id="comment-review-reason" class="textarea short" value="{{reason}}" focus="{{focusReason}}" bindinput="input" maxlength="-1" disabled="{{processing}}" placeholder="2–200字" adjust-position cursor-spacing="80" aria-label="评论处理说明2至200字"/><view class="row"><button wx:if="{{filter === 'pending'}}" class="secondary grow" bindtap="decide" data-decision="reject" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">驳回</button><button wx:if="{{filter === 'pending'}}" class="primary grow" bindtap="decide" data-decision="approve" disabled="{{processing}}" loading="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">审核通过</button><button wx:else class="danger grow" bindtap="decide" data-decision="hide" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">下架评论</button></view></block></view><view wx:if="{{pageError}}" class="notice error">{{pageError}}</view><button wx:if="{{hasMore}}" class="secondary full" bindtap="more" disabled="{{loadingMore || processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">加载更多</button></view></view>