<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <view class="content">
    <view class="page-intro">
      <view class="intro-icon">
        <image src="/static/campus/shield.svg" aria-hidden="true" />
      </view>
      <view class="grow">
        <view class="intro-title">
          我的举报
        </view>
        <view class="sub">
          处理进度和结果，在这里查看。
        </view>
      </view>
    </view>
    <view class="notice">
      举报内容仅本人和处理人员可见。
    </view>
    <scroll-view scroll-x class="report-filter-scroll">
      <view class="report-filter">
        <button wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'active' : ''}}" aria-label="{{item.label}}，{{filter === item.value ? '已选择' : '未选择'}}" data-value="{{item.value}}" bindtap="changeFilter" hover-class="press" hover-start-time="0" hover-stay-time="120">
          {{item.label}}
        </button>
      </view>
    </scroll-view>
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{loading && !items.length}}" kind="loading" title="正在读取举报记录" description="正在连接校园回声。" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{error && !items.length && !accessError}}" kind="error" title="举报记录暂时没能加载" description="{{error}}" action="重新加载" bind:action="retry" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{!allowed}}" kind="access" title="当前无法查看举报记录" description="此页面需要有效内测资格。" action="查看资格" bind:action="goAccess" />
    <block wx:else>
      <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{!items.length}}" kind="empty" title="当前没有符合条件的举报" description="可以切换状态查看其他记录，或下拉刷新。" action="返回论坛" bind:action="wall" />
      <view wx:if="{{loading && items.length}}" class="notice">
        正在刷新，已加载记录保留。
      </view>
      <view wx:if="{{error && items.length}}" class="notice error">
        {{error}}
        <button class="text-button report-retry" bindtap="retry" hover-class="press" hover-start-time="0" hover-stay-time="120">
          重新加载
        </button>
      </view>
      <view wx:for="{{items}}" wx:key="_id" class="card report-card">
        <view class="between">
          <text class="tag {{item.status === 'pending' ? 'pending' : item.status === 'hidden' ? 'hidden' : ''}}">
            {{item.statusLabel}}
          </text>
        </view>
        <view class="card-title">
          {{item.reasonLabel}}
        </view>
        <view class="report-number">
          举报编号 · {{item.number}}
        </view>
        <view class="report-record sub">
          <text>
            提交于 {{item.displayTime}}
          </text>
          <text wx:if="{{item.resolvedTime}}">
            处理于 {{item.resolvedTime}}
          </text>
          <text wx:if="{{item.evidenceExpired}}">
            证据内容已清除
          </text>
        </view>
        <button class="text-button report-link full" bindtap="open" data-id="{{item._id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
          查看结果
          <image class="icon-small" src="/static/campus/next.svg" aria-hidden="true" />
        </button>
      </view>
      <view wx:if="{{items.length}}">
        <view wx:if="{{pageError}}" class="notice error" aria-role="alert">
          {{pageError}}
        </view>
        <button wx:if="{{hasMore}}" class="load-more" disabled="{{loadingMore}}" bindtap="loadMore" hover-class="press" hover-start-time="0" hover-stay-time="120">
          {{loadingMore ? '正在加载下一页…' : pageError ? '重试加载下一页' : '加载下一页'}}
        </button>
        <view wx:else class="footnote">
          已显示全部举报记录
        </view>
      </view>
    </block>
  </view>
</view>
