<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <view class="forum-head">
    <button class="forum-icon" bindtap="search" aria-label="搜索"><image src="/static/campus/search.svg" /></button>
    <text class="forum-brand">校园回声</text>
  </view>
  <view class="content tab-content forum-content">
    <view wx:if="{{sessionNotice}}" class="notice">{{sessionNotice}}</view>
    <view wx:if="{{wallNotice}}" class="notice">{{wallNotice}}</view>
    <scroll-view class="chip-scroll" scroll-x>
      <view class="chip-list">
        <button wx:for="{{sections}}" wx:key="value"
          class="chip {{filter === item.value ? 'active' : ''}}"
          data-value="{{item.value}}" bindtap="changeFilter" aria-pressed="{{filter === item.value}}"
          hover-class="press" hover-start-time="0" hover-stay-time="120">{{item.label}}</button>
      </view>
    </scroll-view>
    <button wx:if="{{access === 'approved'}}" class="forum-compose" bindtap="publish">
      <image class="compose-avatar" src="/static/presets/{{canManageAdmins ? 'official' : 'avatar-1'}}.jpg" />
      <text class="grow">{{filter === 'experience' ? '分享经验' : '有什么新鲜事？'}}</text>
      <image class="compose-plus" src="/static/campus/plus.svg" aria-hidden="true" />
    </button>
    <navigator wx:if="{{filter === 'experience' && access === 'approved'}}" class="experience-recommended" url="/pages/experience/index?recommended=1">精选经验 ›</navigator>
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{loading && !items.length}}" kind="loading" title="正在加载" description="正在连接校园回声，请稍候。" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{error && !items.length}}" kind="error" title="暂时没能加载" description="{{error}}" action="重新加载"
      bind:action="retry" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{!loading && access !== 'approved' && access !== 'error'}}" kind="access"
      title="{{access === 'pending' ? '内测申请正在审核' : access === 'revoked' ? '内测资格已撤销' : '论坛正在封闭内测'}}"
      description="{{access === 'pending' ? '管理员批准后即可阅读和发布论坛内容。' : '请先申请内测资格。'}}" action="查看内测资格"
      bind:action="goAccess" />
    <block wx:if="{{access === 'approved' && (items.length || (!loading && !error))}}">
      <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{!items.length}}" title="{{filter === 'experience' ? '暂无经验分享' : '还没有帖子'}}" action="{{filter === 'experience' ? '分享经验' : '发布帖子'}}"
        bind:action="publish" />
      <view wx:if="{{error && items.length}}" class="notice error">{{error}}
        <button class="text-button" bindtap="retry" hover-class="press" hover-start-time="0" hover-stay-time="120">重新加载</button>
      </view>
      <campus-post interactive reduced-motion="{{reducedMotion}}" wx:for="{{items}}" wx:key="_id" post="{{item}}" bind:open="openPost" />
      <view wx:if="{{items.length}}">
        <view wx:if="{{pageError}}" class="notice error">{{pageError}}</view>
        <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" disabled="{{loadingMore}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
          {{loadingMore ? '正在加载更多…' : pageError ? '重试加载下一页' : '加载下一页'}}</button>
        <view wx:else class="footnote">已经看到全部内容</view>
      </view>
    </block>
  </view>
</view>
