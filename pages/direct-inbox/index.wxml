<view class="direct-page {{reducedTransparency ? 'solid' : ''}}">
  <view class="inbox-head"><text class="inbox-title">私信</text><button class="inbox-compose" bindtap="compose" aria-label="新私信"><image src="/static/campus/compose-white.svg" aria-hidden="true" /></button></view>
  <block wx:if="{{composing}}">
    <view class="search inbox-search">
      <image src="/static/campus/search.svg" aria-hidden="true" />
      <input value="{{nickname}}" bindinput="nickname" bindconfirm="findMember" confirm-type="search" maxlength="16" placeholder="输入完整用户名" aria-label="用户名" />
      <button class="text-button" bindtap="findMember" disabled="{{finding || nickname.length < 2}}">搜索</button>
      <button class="text-button" bindtap="closeCompose">取消</button>
    </view>
    <view wx:if="{{findError}}" class="feedback">{{findError}}</view>
    <view wx:elif="{{users && !users.length}}" class="feedback">没有找到这个用户名</view>
    <button wx:for="{{users}}" wx:key="id" class="conversation" data-id="{{item.id}}" bindtap="openMember">
      <image class="face" src="/static/presets/avatar-1.jpg" mode="aspectFill" />
      <text class="name">{{item.name}}</text>
    </button>
  </block>
  <block wx:else>
  <view class="search inbox-search">
    <image src="/static/campus/search.svg" aria-hidden="true" />
    <input placeholder="搜索会话" placeholder-class="direct-placeholder" aria-label="搜索会话" value="{{query}}" bindinput="search" />
  </view>
  <view class="filters">
    <button class="pill {{tab === 'inbox' ? 'selected' : ''}}" data-tab="inbox" bindtap="select">收件箱</button>
    <button class="pill {{tab === 'requests' ? 'selected' : ''}}" data-tab="requests" bindtap="select">请求</button>
  </view>
  <view wx:if="{{error}}" class="feedback">{{error}}<button class="pill" bindtap="load">重试</button></view>
  <view wx:elif="{{loading && !items.length}}" class="feedback">正在加载私信…</view>
  <view wx:elif="{{!items.length}}" class="feedback">{{query ? '没有匹配的会话' : tab === 'requests' ? '暂无私信请求' : '暂无私信'}}</view>
  <button wx:for="{{items}}" wx:key="id" class="conversation" bindtap="open" data-id="{{item.id}}">
    <image class="face" src="/static/presets/avatar-1.jpg" mode="aspectFill" />
    <view class="row-copy"><view class="name">{{item.name}}</view><view class="snippet">{{item.last}} · {{item.time}}</view></view>
    <view wx:if="{{item.unread}}" class="unread" aria-label="未读"></view>
  </button>
  </block>
</view>
