<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <view class="content">
    <view class="page-intro"><view class="intro-icon"><image src="/static/campus/users.svg" aria-hidden="true" /></view><view class="grow"><view class="intro-title">内测成员</view><view class="sub">从申请到获准，认真核对每一位同学。</view></view></view>
    <view class="notice">只有获准账号可以使用论坛。初始管理员可给已获准成员授权管理员，对方使用同一微信账号即可管理，无需另外登录。</view>
    <view wx:if="{{canManageAdmins}}" class="notice success">你是初始管理员，可在“已获准”列表授予或取消管理员。取消管理员后仍保留普通内测资格。</view>
    <view wx:if="{{roleConflict && !processing}}" class="notice warning" aria-role="text">
      <view>{{checkingRoles ? '正在核对本次授权结果，请稍候。' : roleCheckError || '本次授权结果尚未确认，核对后才可继续操作。'}}</view>
      <button class="text-button" bindtap="verifyRoles" disabled="{{checkingRoles}}" loading="{{checkingRoles}}" hover-class="press" hover-start-time="0" hover-stay-time="120">重新核对权限与角色</button>
    </view>
    <scroll-view class="chip-scroll" scroll-x>
      <view class="chip-list">
        <button wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'active' : ''}}"
          aria-label="{{item.label}}，{{filter === item.value ? '已选择' : '未选择'}}" data-value="{{item.value}}" bindtap="changeFilter" disabled="{{processing || checkingRoles || roleConflict}}" hover-class="press" hover-start-time="0" hover-stay-time="120">{{item.label}}</button>
      </view>
    </scroll-view>
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{loading && !items.length}}" kind="loading" title="正在加载" description="正在连接校园回声，请稍候。" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{error && !items.length}}" kind="error" title="暂时没能加载" description="{{error}}" action="重新加载"
      bind:action="retry" />
    <block wx:if="{{items.length || (!loading && !error)}}">
      <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{access !== 'approved' || member.role !== 'admin'}}" kind="access" title="需要管理员权限"
        description="仅当前获准管理员可以审批内测申请。" action="查看资格" bind:action="goAccess" />
      <block wx:else>
        <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{!items.length}}" title="这个列表暂时为空" description="下拉刷新可获取最新成员状态。" />
        <view wx:if="{{loading && items.length}}" class="notice">正在刷新，已加载内容保留。</view>
        <view wx:if="{{error && items.length}}" class="notice error">{{error}}
          <button class="text-button" bindtap="retry" hover-class="press" hover-start-time="0" hover-stay-time="120">重新加载</button>
        </view>
        <view wx:for="{{items}}" wx:key="id" class="card member-card">
          <view class="meta">
            <view class="avatar" aria-hidden="true">{{item.nickname[0]}}</view>
            <view class="grow">
              <view class="name">{{item.nickname}}</view>
              <view class="sub">{{item.displayTime}}</view>
            </view><text class="tag {{item.status}}">{{item.role === 'admin' ? '管理员' : item.statusLabel}}</text>
          </view>
          <view wx:if="{{item.reason}}" class="card-copy status-block">申请说明：{{item.reason}}</view>
          <view wx:if="{{item.reviewReason}}" class="sub status-block">处理说明：{{item.reviewReason}}</view>
          <view wx:if="{{item.role !== 'admin'}}">
            <view wx:if="{{item.status === 'pending'}}" class="row">
              <button class="secondary grow" data-id="{{item.id}}" data-decision="reject" bindtap="choose"
                disabled="{{processing || checkingRoles || roleConflict}}" hover-class="press" hover-start-time="0" hover-stay-time="120">不批准</button>
              <button class="primary grow" data-id="{{item.id}}" data-decision="approve" bindtap="choose"
                disabled="{{processing || checkingRoles || roleConflict}}" loading="{{processing === item.id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">批准内测</button>
            </view>
            <button wx:if="{{item.status === 'rejected' || item.status === 'revoked'}}" class="primary full" data-id="{{item.id}}" data-decision="approve" bindtap="choose" disabled="{{processing || checkingRoles || roleConflict}}" loading="{{processing === item.id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">重新批准内测</button>
            <button wx:if="{{item.status === 'approved'}}" class="text-button danger-text full" data-id="{{item.id}}"
              data-decision="revoke" bindtap="choose" disabled="{{processing || checkingRoles || roleConflict}}" hover-class="press" hover-start-time="0" hover-stay-time="120">撤销资格</button>
          </view>
          <view wx:if="{{item.role !== 'admin' && item.status === 'approved'}}"><view class="sub">{{item.banned ? '已封禁新社区活动及新交易' : item.mutedUntil ? '禁言状态以服务端时间为准' : '无社区处罚'}}</view><view class="row-wrap"><button class="text-button" data-id="{{item.id}}" data-decision="mute" bindtap="chooseSanction" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">禁言7天</button><button class="text-button danger-text" data-id="{{item.id}}" data-decision="ban" bindtap="chooseSanction" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">封禁</button><button class="text-button" data-id="{{item.id}}" data-decision="clear" bindtap="chooseSanction" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">解除处罚</button></view></view>
          <view wx:if="{{sanctionFor === item.id}}" class="form-panel"><label class="label" for="sanction-reason">处罚或解除原因</label><textarea id="sanction-reason" class="textarea short" value="{{sanctionReason}}" bindinput="sanctionInput" maxlength="-1" adjust-position cursor-spacing="80" aria-label="处罚或解除原因2至200字"/><view class="notice">禁言阻止发布、编辑和评论。封禁阻止新社区活动及新交易；既有订单、权益和售后保留。</view><view wx:if="{{formError}}" class="field-error">{{formError}}</view><button class="danger full" bindtap="submitSanction" disabled="{{processing}}" loading="{{processing === item.id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">核对后提交处罚</button></view>
          <button wx:if="{{canManageAdmins && item.status === 'approved' && item.id !== member.id}}" class="secondary full" data-id="{{item.id}}" bindtap="role" disabled="{{processing || checkingRoles || roleConflict}}" loading="{{processing === item.id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">{{item.role === 'admin' ? '取消管理员' : '授予管理员'}}</button>
          <view wx:if="{{reasonFor === item.id}}" class="status-block member-decision">
            <label class="label" for="member-reason">{{decision === 'revoke' ? '撤销资格原因' : '不批准原因'}}</label><textarea id="member-reason" focus="{{focusReason}}" aria-invalid="{{!!formError}}" aria-describedby="member-reason-error" aria-label="成员资格处理原因，2至200字" class="textarea short" value="{{reason}}" bindinput="input" maxlength="-1" disabled="{{processing || checkingRoles || roleConflict}}" placeholder="请填写明确原因，2–200 字" adjust-position cursor-spacing="32"/>
            <view wx:if="{{formError}}" id="member-reason-error" class="field-error" aria-role="text">{{formError}}</view>
            <view class="row status-block">
              <button class="secondary grow" bindtap="cancelReason" disabled="{{processing || checkingRoles || roleConflict}}" hover-class="press" hover-start-time="0" hover-stay-time="120">取消</button>
              <button class="danger grow" bindtap="submitReason" loading="{{processing === item.id}}"
                disabled="{{processing || checkingRoles || roleConflict}}" hover-class="press" hover-start-time="0" hover-stay-time="120">确认处理</button>
            </view>
          </view>
        </view>
        <view wx:if="{{items.length}}">
          <view wx:if="{{pageError}}" class="notice error">{{pageError}}</view>
          <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" disabled="{{loadingMore || checkingRoles || roleConflict}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
            {{loadingMore ? '正在加载更多…' : pageError ? '重试加载下一页' : '加载下一页'}}</button>
          <view wx:else class="footnote">已经看到全部内容</view>
        </view>
      </block>
    </block>
  </view>
</view>
