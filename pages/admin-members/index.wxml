<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <view class="content">
    <view class="notice">只有获准账号可以使用真实校园墙。撤销资格立即生效，初始管理员不能在此撤销。</view>
    <scroll-view class="chip-scroll" scroll-x>
      <view class="chip-list">
        <button wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'active' : ''}}"
          aria-label="{{item.label}}，{{filter === item.value ? '已选择' : '未选择'}}" data-value="{{item.value}}" bindtap="changeFilter" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">{{item.label}}</button>
      </view>
    </scroll-view>
    <campus-state wx:if="{{loading && !items.length}}" kind="loading" title="正在加载" description="正在连接校园回声，请稍候。" />
    <campus-state wx:elif="{{error && !items.length}}" kind="error" title="暂时没能加载" description="{{error}}" action="重新加载"
      bind:action="retry" />
    <block wx:if="{{items.length || (!loading && !error)}}">
      <campus-state wx:if="{{access !== 'approved' || member.role !== 'admin'}}" kind="access" title="需要管理员权限"
        description="仅当前获准管理员可以审批内测申请。" action="查看资格" bind:action="goAccess" />
      <block wx:else>
        <campus-state wx:if="{{!items.length}}" title="这个列表暂时为空" description="下拉刷新可获取最新成员状态。" />
        <view wx:if="{{loading && items.length}}" class="notice">正在刷新，已加载内容保留。</view>
        <view wx:if="{{error && items.length}}" class="notice error">{{error}}
          <button class="text-button" bindtap="retry" hover-class="press" hover-start-time="0" hover-stay-time="120">重新加载</button>
        </view>
        <view wx:for="{{items}}" wx:key="id" class="card">
          <view class="meta">
            <view class="avatar" aria-hidden="true">{{item.nickname[0]}}</view>
            <view class="grow">
              <view class="name">{{item.nickname}}</view>
              <view class="sub">{{item.displayTime}}</view>
            </view><text class="tag {{item.status}}">{{item.role === 'admin' ? '管理员' : item.statusLabel}}</text>
          </view>
          <view wx:if="{{item.reason}}" class="card-copy status-block">申请说明：{{item.reason}}</view>
          <view wx:if="{{item.reviewReason}}" class="sub status-block">处理说明：{{item.reviewReason}}</view>
          <view wx:if="{{item.role !== 'admin'}}">
            <view wx:if="{{item.status === 'pending'}}" class="row">
              <button class="secondary grow" data-id="{{item.id}}" data-decision="reject" bindtap="choose"
                disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">不批准</button>
              <button class="primary grow" data-id="{{item.id}}" data-decision="approve" bindtap="choose"
                disabled="{{processing}}" loading="{{processing === item.id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">批准内测</button>
            </view>
            <button wx:if="{{item.status === 'rejected' || item.status === 'revoked'}}" class="primary full" data-id="{{item.id}}" data-decision="approve" bindtap="choose" disabled="{{processing}}" loading="{{processing === item.id}}" hover-class="press" hover-start-time="0" hover-stay-time="120">重新批准内测</button>
            <button wx:if="{{item.status === 'approved'}}" class="text-button danger-text full" data-id="{{item.id}}"
              data-decision="revoke" bindtap="choose" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">撤销资格</button>
          </view>
          <view wx:if="{{reasonFor === item.id}}" class="status-block">
            <label class="label" for="member-reason">{{decision === 'revoke' ? '撤销资格原因' : '不批准原因'}}</label><textarea id="member-reason" focus="{{focusReason}}" aria-invalid="{{!!formError}}" aria-describedby="member-reason-error" aria-label="成员资格处理原因，2至200字" class="textarea short" value="{{reason}}" bindinput="input" maxlength="-1" disabled="{{processing}}" placeholder="请填写明确原因，2–200 字" adjust-position cursor-spacing="32"/>
            <view wx:if="{{formError}}" id="member-reason-error" class="field-error" aria-role="text">{{formError}}</view>
            <view class="row status-block">
              <button class="secondary grow" bindtap="cancelReason" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">取消</button>
              <button class="danger grow" bindtap="submitReason" loading="{{processing === item.id}}"
                disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">确认处理</button>
            </view>
          </view>
        </view>
        <view wx:if="{{items.length}}">
          <view wx:if="{{pageError}}" class="notice error">{{pageError}}</view>
          <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" disabled="{{loadingMore}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
            {{loadingMore ? '正在加载更多…' : pageError ? '重试加载下一页' : '加载下一页'}}</button>
          <view wx:else class="footnote">已经看到全部内容</view>
        </view>
      </block>
    </block>
  </view>
</view>
