<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}"><view class="content trade-wrap">
<campus-state wx:if="{{loading}}" kind="loading" title="正在读取订单"/><campus-state wx:elif="{{!order}}" kind="error" title="订单暂不可查看" description="{{error}}" action="重新加载" bind:action="load"/>
<block wx:else><view class="trade-panel"><view class="trade-row"><text class="trade-status">{{order.statusLabel}}</text><text class="sub">订单 {{order.shortId}}</text><button class="text-button" bindtap="load">刷新</button></view><view class="trade-title">{{order.title}}</view><view class="trade-note">{{order.description}}</view><view class="trade-price">{{order.displayPrice}}</view><view class="trade-note">{{order.displayTime}} · {{order.viewerRole === 'buyer' ? '我的买入' : order.viewerRole === 'seller' ? '我的卖出' : '管理员核查'}}</view><view class="trade-divider"/><view class="trade-value">{{order.deliveryLabel}}</view><view wx:if="{{order.claimTime}}" class="trade-note">首次领取 {{order.claimTime}}，再次领取不重置期限。</view><view wx:if="{{order.reminderDue}}" class="notice warning">超过48小时待卖家核对{{order.interventionAllowed ? '，可申请人工协调。' : '，可先在订单留言。'}}</view></view>
<button wx:if="{{order.viewerRole === 'buyer' || order.viewerRole === 'seller'}}" class="secondary full" bindtap="contactPeer">私信{{order.viewerRole === 'buyer' ? '卖家' : '买家'}}</button>
<view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="notice error" aria-role="alert">{{error}}</view>
<view class="trade-panel"><view class="trade-row"><button wx:if="{{order.viewerRole === 'buyer' && (order.status === 'awaitingPayment' || order.status === 'awaitingSeller')}}" class="primary grow" bindtap="payment" disabled="{{!!busy}}">{{order.status === 'awaitingPayment' ? '收款信息与凭证' : '查看提交凭证'}}</button><button wx:if="{{order.viewerRole === 'seller' && order.status === 'awaitingSeller'}}" class="primary grow" bindtap="payment">查看凭证与核对到账</button><button wx:if="{{order.viewerRole === 'buyer' && (order.status === 'deliverable' || order.status === 'completed')}}" class="primary grow" bindtap="claim" disabled="{{!!busy || order.deliveryStatus !== 'ready'}}" loading="{{busy === 'claim'}}">{{order.deliveryStatus === 'ready' ? '打开专属PDF' : order.deliveryLabel}}</button><button wx:if="{{order.viewerRole === 'buyer' && order.deliveryStatus === 'failed'}}" class="secondary grow" bindtap="retryDelivery" disabled="{{!!busy}}">重试生成</button><button wx:if="{{order.viewerRole === 'buyer' && order.status === 'awaitingPayment'}}" class="secondary" bindtap="cancel" disabled="{{!!busy}}">取消订单</button><button wx:if="{{order.viewerRole === 'buyer' && order.status === 'deliverable' && order.firstClaimAt && !order.afterSaleOpen}}" class="secondary" bindtap="complete" disabled="{{!!busy}}">确认完成</button></view><view class="trade-footer">文件任务由服务端定时处理，可稍后点击刷新。失败不会记为交付成功。</view></view>
<view class="trade-panel"><view class="section-title">售后与人工协调</view><view class="trade-note">平台收集事实、记录协调；不代退款、不裁决钱款。</view><button wx:if="{{order.viewerRole === 'buyer'}}" class="secondary full" bindtap="support">{{order.afterSaleOpen ? '查看未结售后或补充留言' : '申请售后 / 技术报修'}}</button><button wx:for="{{sales}}" wx:key="_id" class="list-link" data-id="{{item._id}}" bindtap="openSale"><text class="grow">{{item.type}}</text><text class="tag">{{item.status === 'open' ? '处理中' : '已结案'}}</text></button><button wx:if="{{salesMore}}" class="text-button full" bindtap="moreSales">更多售后记录</button></view>
<view class="trade-panel"><view class="section-title">订单留言</view><view class="trade-note">交易双方及订单处理人员可见。</view><view wx:if="{{order.evidenceCleared}}" class="notice">历史私有内容已按期限清除，必要订单记录保留。</view><view wx:for="{{messages}}" wx:key="_id" class="trade-message"><view class="trade-note">{{item.speakerLabel}} · {{item.displayTime}}</view><view class="trade-value">{{item.cleared ? '私有内容已到期清除' : item.content}}</view></view><button wx:if="{{hasMoreMessages}}" class="text-button full" bindtap="moreMessages">更多留言</button><view wx:if="{{messageError}}" class="notice error" aria-role="alert">{{messageError}}</view><textarea class="trade-textarea" value="{{message}}" maxlength="-1" bindinput="input" placeholder="补充与本订单有关的事实，最多500字" aria-label="订单留言" adjust-position="{{true}}" cursor-spacing="24"/><view class="trade-counter">{{messageCount}} / 500</view><button class="primary full" bindtap="send" loading="{{busy === 'message'}}" disabled="{{!!busy}}">提交留言</button></view>
<view wx:if="{{order.viewerRole === 'buyer' && order.firstClaimAt}}" class="trade-panel"><view class="section-title">这份资料对你有帮助吗</view><view class="trade-note">三选反馈仅私有保存。</view><view class="trade-row"><button class="trade-chip" bindtap="feedback" data-value="补漏有用" disabled="{{!!busy}}">补漏有用</button><button class="trade-chip" bindtap="feedback" data-value="看不懂" disabled="{{!!busy}}">看不懂</button><button class="trade-chip" bindtap="feedback" data-value="太水" disabled="{{!!busy}}">太水</button></view></view>
</block></view></view>