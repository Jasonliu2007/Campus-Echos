<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}"><view class="content trade-wrap"><view class="trade-head"><view class="trade-title">资料与交易管理</view><view class="trade-note">全量核查资料，协调真实事实。不能代替卖家确认到账。</view></view><view class="trade-row"><button wx:for="{{tabs}}" wx:key="id" class="trade-chip {{tab === item.id ? 'selected' : ''}}" data-tab="{{item.id}}" bindtap="tab">{{item.label}}</button></view><campus-state wx:if="{{loading}}" kind="loading" title="正在读取待办"/><campus-state wx:elif="{{error && !items.length}}" kind="error" title="待办读取失败" description="{{error}}" action="重试" bind:action="retry"/><campus-state wx:elif="{{!items.length}}" title="当前没有待处理记录" description="新申请与投诉将出现在相应列表。"/><button wx:for="{{items}}" wx:key="_id" class="trade-list" data-id="{{item._id}}" bindtap="open"><view class="trade-list-title">{{item.title || item.type || '资料投诉'}}</view><view class="trade-note">{{item.displayTime}}</view><view wx:if="{{item.overdue}}" class="notice warning">超过24小时未处理</view><view class="trade-note">{{item.reason}}</view></button><view wx:if="{{error && items.length}}" class="notice error" aria-role="alert">{{error}}</view><button wx:if="{{hasMore}}" class="secondary full" bindtap="more" disabled="{{loadingMore}}" loading="{{loadingMore}}">加载更多</button><view wx:if="{{!selected && reason}}" class="trade-panel"><view class="section-title">本页未提交说明</view><view class="trade-note">说明仍保留。重新打开原投诉可继续核对，或明确放弃。</view><view class="trade-value">{{reason}}</view><button class="secondary full" bindtap="close">放弃这份说明</button></view><view wx:if="{{selected}}" class="trade-panel"><view class="section-title">资料投诉核查</view><view class="trade-value">{{selected.reason}}</view><view class="trade-note">资料编号 {{selected.materialId}} · 版本 {{selected.versionId}}</view><button class="secondary full" bindtap="inspect" disabled="{{busy}}">私有查看被投诉版本的完整PDF</button><label class="trade-label" for="complaint-reason">核查说明（2–200字）</label><textarea aria-label="投诉核查说明，2到200字" id="complaint-reason" class="trade-textarea" value="{{reason}}" bindinput="input" maxlength="-1" adjust-position="{{true}}" cursor-spacing="24"/><view class="trade-row"><button class="primary grow" data-decision="restrict" bindtap="resolve" disabled="{{busy}}">维持限制并结案</button><button class="secondary grow" data-decision="restore" bindtap="resolve" disabled="{{busy}}">核查通过并尝试恢复</button></view><button class="text-button full" bindtap="close" disabled="{{busy}}">关闭</button></view></view></view>