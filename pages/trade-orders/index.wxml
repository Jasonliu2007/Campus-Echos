<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}"><view class="content trade-wrap"><view class="trade-head"><view class="section-caption">校园回声 / 资料交易</view><view class="trade-title">每一份整理，都有记录</view><view class="trade-note">当前付费未开放；免费资料订单与必要售后独立保留。</view></view><view class="trade-grid"><button class="trade-chip {{side === 'buyer' ? 'selected' : ''}}" data-side="buyer" bindtap="side">我的买入</button><button class="trade-chip {{side === 'seller' ? 'selected' : ''}}" data-side="seller" bindtap="side">我的卖出</button></view><view class="trade-row"><button class="text-button" bindtap="materials">我上架的资料</button><button class="text-button" bindtap="retry" disabled="{{loading}}">刷新</button></view><campus-state wx:if="{{loading}}" kind="loading" title="正在读取订单"/><campus-state wx:elif="{{error}}" kind="error" title="订单暂时无法读取" description="{{error}}" action="重试" bind:action="retry"/><campus-state wx:elif="{{!items.length}}" title="还没有这类订单" description="在资料详情查看目录和试读，确认适合后再领取。"/><button wx:for="{{items}}" wx:key="_id" class="trade-list" data-id="{{item._id}}" bindtap="open"><view class="trade-row"><text class="trade-status">{{item.statusLabel}}</text><text class="sub">{{item.shortId}}</text></view><view class="trade-list-title">{{item.title}}</view><view class="trade-row"><text class="grow sub">{{item.deliveryLabel}}</text><text class="trade-price">{{item.displayPrice}}</text></view><view class="trade-note">{{item.displayTime}}{{item.afterSaleOpen ? ' · 售后处理中' : ''}}</view><view wx:if="{{item.reminderDue}}" class="notice warning">已超过48小时待确认{{item.interventionAllowed ? '，可申请人工协调' : ''}}</view></button><view wx:if="{{pageError}}" class="notice error">{{pageError}}</view><button wx:if="{{hasMore}}" class="secondary full" bindtap="more" disabled="{{loadingMore}}" loading="{{loadingMore}}">加载更多</button></view></view>