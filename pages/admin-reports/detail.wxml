<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <view class="content report-content">
    <view class="page-intro">
      <view class="intro-icon">
        <image src="/static/campus/shield.svg" aria-hidden="true" />
      </view>
      <view class="grow">
        <view class="intro-title">
          核对与处理
        </view>
        <view class="sub">
          人工核实，清楚记录。
        </view>
      </view>
    </view>
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{loading}}" kind="loading" title="正在读取举报" description="正在核对最新权限和记录。" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{error && !report && !accessError}}" kind="error" title="举报记录暂时无法读取" description="{{error}}" action="重新加载" bind:action="load" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{!allowed}}" kind="access" title="当前资格无法查看本页" description="权限可能已发生变化，请核对账号状态。" action="查看资格" bind:action="goAccess" />
    <block wx:elif="{{report}}">
      <view wx:if="{{info}}" class="notice success" aria-role="status">
        {{info}}
      </view>
      <view class="reading-panel">
        <view class="between">
          <text class="tag {{report.status === 'pending' ? 'pending' : report.status === 'hidden' ? 'hidden' : ''}}">
            {{report.statusLabel}}
          </text>
          <text class="report-number">
            R · {{report.number}}
          </text>
        </view>
        <view class="report-heading report-copy">
          {{report.reasonLabel}}
        </view>
        <view class="report-record sub">
          <text>
            提交于 {{report.displayTime}}
          </text>
          <text wx:if="{{report.resolvedTime}}">
            处理于 {{report.resolvedTime}}
          </text>
          <text>
            目标内容状态 · {{report.postState}}
          </text>
          <text wx:if="{{report.overdue}}">
            已超过24小时未处理
          </text>
        </view>
      </view>
      <view class="reading-panel">
        <view class="report-heading">
          {{report.targetType === 'comment' ? '当时评论快照' : '当时帖子快照'}}
        </view>
        <view class="notice">
          仅管理员可见，不向帖子作者公开举报者或补充说明。
        </view>
        <block wx:if="{{!report.evidenceExpired && report.snapshot}}">
          <view class="sub">
            {{report.snapshot.category}}
          </view>
          <view class="card-title">
            {{report.snapshot.title}}
          </view>
          <view class="report-snapshot" user-select>
            {{report.snapshot.content}}
          </view>
          <view wx:for="{{evidenceImages}}" wx:key="mediaId"><image wx:if="{{item.url}}" src="{{item.url}}" mode="widthFix" style="width:100%;border-radius:24rpx" data-id="{{item.mediaId}}" bindtap="previewEvidence" aria-label="查看保留期内证据图片"/><view wx:else class="notice">{{item.label}}</view></view>
        </block>
        <view wx:else class="notice">
          证据内容已清除或暂不可用。保留必要记录，不提供恢复入口。
        </view>
      </view>
      <view class="reading-panel">
        <view class="report-heading">
          举报补充说明
        </view>
        <view wx:if="{{report.evidenceExpired}}" class="notice">
          结案已满30天，证据内容已清除，不再展示原文与自由说明。
        </view>
        <view wx:else class="report-private-copy" user-select>
          {{report.detail || '未填写补充说明。'}}
        </view>
      </view>
      <view wx:if="{{report.status === 'pending'}}" class="form-panel">
        <view class="report-heading">
          处理决定
        </view>
        <view wx:if="{{!report.currentPost || report.currentPost.status !== 'published' || (report.targetType === 'comment' && (!report.currentComment || report.currentComment.status !== 'published'))}}" class="report-fixed">
          内容已不可见 · 仅结案，不恢复帖子。
        </view>
        <view wx:else class="report-decision" aria-role="radiogroup" aria-label="处理决定">
          <button class="report-option {{decision === 'hide' ? 'active' : ''}}" aria-role="radio" aria-label="认定违规并下架，{{decision === 'hide' ? '已选择' : '未选择'}}" data-value="hide" bindtap="choose" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
            认定违规并下架
            <view class="report-radio" aria-hidden="true" />
          </button>
          <button class="report-option {{decision === 'dismiss' ? 'active' : ''}}" aria-role="radio" aria-label="未认定违规并结案，{{decision === 'dismiss' ? '已选择' : '未选择'}}" data-value="dismiss" bindtap="choose" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
            未认定违规并结案
            <view class="report-radio" aria-hidden="true" />
          </button>
        </view>
        <label class="label" for="report-reason">
          处理说明
          <text class="required">
            *
          </text>
        </label>
        <textarea id="report-reason" class="textarea short" value="{{reason}}" bindinput="input" focus="{{focusReason}}" maxlength="-1" disabled="{{processing}}" adjust-position cursor-spacing="100" show-confirm-bar placeholder="填写核实依据，2–200字" aria-label="处理说明，必填2至200字。{{reasonError}}" />
        <view class="field-hint">
          <text>
            仅管理员可见，作者看到固定下架提示
          </text>
          <text class="counter">
            {{reasonCount}} / 200
          </text>
        </view>
        <view class="field-error report-form-error" aria-role="alert">
          {{reasonError}}
        </view>
      </view>
      <view wx:elif="{{!report.evidenceExpired}}" class="reading-panel">
        <view class="report-heading">
          处理记录
        </view>
        <view class="report-private-copy">
          {{report.resultCopy}}
        </view>
        <view class="report-private-copy report-copy" user-select>
          {{report.resolveReason || '未保留自由说明。'}}
        </view>
        <view class="sub report-copy">
          证据内容保留至 {{report.expiresTime}}，到期不再显示。
        </view>
      </view>
      <view wx:if="{{error}}" class="notice error" aria-role="alert">
        {{error}}
        <view wx:if="{{conflict}}">
          处理说明已保留。请刷新后重新阅读，再次确认。
        </view>
        <button wx:if="{{conflict}}" class="secondary full report-retry" bindtap="refreshConflict" hover-class="press" hover-start-time="0" hover-stay-time="120">
          刷新并核对
        </button>
      </view>
    </block>
  </view>
  <view wx:if="{{allowed && report && !loading}}" class="sticky-actions report-actions">
    <button class="secondary" bindtap="back" disabled="{{processing}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
      返回
    </button>
    <button wx:if="{{report.status === 'pending'}}" class="primary" bindtap="decide" disabled="{{processing || conflict || report.evidenceExpired}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
      {{processing ? '正在处理…' : !report.currentPost || report.currentPost.status !== 'published' || (report.targetType === 'comment' && (!report.currentComment || report.currentComment.status !== 'published')) ? '核对后结案' : '核对后处理'}}
    </button>
    <button wx:else class="primary" bindtap="back" hover-class="press" hover-start-time="0" hover-stay-time="120">
      返回举报列表
    </button>
  </view>
</view>
