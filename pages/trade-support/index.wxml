<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}"><view class="content trade-wrap"><view class="trade-head"><view class="section-caption">校园回声 / 私有协调</view><view class="trade-title">{{mode === 'complaint' ? '资料版权与安全投诉' : case ? '售后处理记录' : '申请售后与技术报修'}}</view><view class="trade-note">记录事实，认真核查。平台不代退款、不裁决款项。</view></view><campus-state wx:if="{{loading}}" kind="loading" title="正在核对记录"/>
<view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="notice error" aria-role="alert">{{error}}</view>
<view wx:if="{{case}}" class="trade-panel"><view class="trade-row"><text class="trade-status">{{case.status === 'open' ? '处理中' : '已结案'}}</text><text class="sub">{{case.type}}</text></view><view class="trade-note">{{case.displayTime}}</view><view wx:if="{{case.contentCleared}}" class="notice">私有说明已按保留期限清除；编号、状态与必要审计事实保留。</view><block wx:else><view class="trade-label">申请事实</view><view class="trade-value">{{case.description}}</view><view wx:if="{{case.coordination}}" class="trade-label">核查与协调</view><view class="trade-value">{{case.coordination}}</view></block><view class="trade-footer">{{case.notice}}</view></view>
<view wx:if="{{!case && (!notice || description)}}" class="trade-panel"><block wx:if="{{mode !== 'complaint'}}"><view class="trade-label">售后类别</view><picker range="{{types}}" bindchange="type"><view class="trade-input">{{type}}</view></picker><view class="trade-note">技术交付问题可持续报修。普通内容售后为首次领取起7天；迟到付款不会自动恢复订单。</view></block><view wx:else class="notice warning">提交后资料进入核查队列，暂停新售卖与新的文件签发。</view><label class="trade-label" for="support-description">{{mode === 'complaint' ? '投诉事实' : '事实说明'}}</label><textarea id="support-description" class="trade-textarea" value="{{description}}" data-key="description" bindinput="input" maxlength="-1" adjust-position="{{true}}" cursor-spacing="24" aria-label="事实说明"/><view class="trade-counter">{{descriptionCount}} / {{mode === 'complaint' ? 200 : 1000}}</view><button class="primary full" bindtap="submit" disabled="{{busy || loading}}" loading="{{busy}}">提交{{mode === 'complaint' ? '投诉' : '申请'}}</button></view>
<view wx:if="{{case && case.status === 'open' && canAdmin}}" class="trade-panel"><view class="section-title">管理员核查与协调</view><view class="trade-label">事实结果</view><picker range="{{resultLabels}}" value="{{resultIndex}}" bindchange="result"><view class="trade-input">{{resultLabels[resultIndex]}}</view></picker><label class="trade-label" for="support-coordination">核查与协调记录（2–1000字）</label><textarea aria-label="核查与协调记录，2到1000字" id="support-coordination" class="trade-textarea" value="{{coordination}}" data-key="coordination" bindinput="input" maxlength="-1" adjust-position="{{true}}" cursor-spacing="24"/><view class="trade-counter">{{coordinationCount}} / 1000</view><button class="primary full" bindtap="resolve" disabled="{{busy}}" loading="{{busy}}">核对后记录结案</button></view><view wx:if="{{localDraftRetained && case}}" class="trade-panel"><view class="section-title">本机未提交说明</view><view class="trade-note">以下内容写于上次提交之后，仅保留在本机。可复制后在订单留言中补充，不代表已经提交。</view><block wx:if="{{description}}"><label class="trade-label" for="retained-description">后续事实说明</label><textarea id="retained-description" class="trade-textarea" value="{{description}}" data-key="description" bindinput="input" maxlength="-1" adjust-position="{{true}}" cursor-spacing="24" aria-label="后续事实说明，本机未提交"/></block><block wx:if="{{coordination}}"><label class="trade-label" for="retained-coordination">后续核查说明</label><textarea id="retained-coordination" class="trade-textarea" value="{{coordination}}" data-key="coordination" bindinput="input" maxlength="-1" adjust-position="{{true}}" cursor-spacing="24" aria-label="后续核查说明，本机未提交"/></block></view><button class="secondary full" bindtap="cancel" disabled="{{busy}}">返回订单</button></view></view>