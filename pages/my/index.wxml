<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <campus-hero title="{{member ? member.nickname : '我的校园回声'}}"
    subtitle="{{member && member.role === 'admin' ? '封闭内测成员 · 管理员' : accessLabel}}" icon="user" />
  <view class="content tab-content">
    <campus-state wx:if="{{loading}}" kind="loading" title="正在获取资格" description="正在核对当前微信账号的内测状态。" />
    <campus-state wx:elif="{{error}}" kind="error" title="资格暂时无法加载" description="{{error}}" action="重新加载"
      bind:action="refresh" />
    <block wx:else>
      <button class="list-link" bindtap="goAccess" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/shield.svg"
          aria-hidden="true" />
        <view class="grow">
          <view class="name">封闭内测资格</view>
          <view class="sub">{{accessLabel}} · 不代表学生实名认证</view>
        </view><image class="icon-small" src="/static/campus/next.svg" aria-hidden="true" />
      </button>
      <view class="section">
        <view class="section-head"><text class="section-title">学习资料</text><text class="demo">演示模块</text></view>
        <view class="grid-two">
          <button class="tile" bindtap="unavailable" data-label="已购笔记" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/bag.svg"
              aria-hidden="true" />已购笔记</button>
          <button class="tile" bindtap="unavailable" data-label="我上架的资料" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
              src="/static/campus/file.svg" aria-hidden="true" />我上架的资料</button>
        </view>
      </view>
      <view class="section">
        <view class="section-head"><text class="section-title">校园与活动</text></view>
        <button class="list-link" bindtap="go" data-url="/pages/my-posts/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/wall.svg" aria-hidden="true" /><text class="grow">我的帖子</text><image class="icon-small"
            src="/static/campus/next.svg" aria-hidden="true" /></button>
        <button class="list-link" bindtap="unavailable" data-label="我创建的活动" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/calendar.svg" aria-hidden="true" /><text class="grow">我创建的活动</text><text
            class="demo">演示</text></button>
        <button class="list-link" bindtap="unavailable" data-label="我加入的活动" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/users.svg" aria-hidden="true" /><text class="grow">我加入的活动</text><text
            class="demo">演示</text></button>
      </view>
      <view wx:if="{{member.role === 'admin' && access === 'approved'}}" class="section">
        <view class="section-head"><text class="section-title">管理工作台</text><text class="sub">仅管理员可见</text></view>
        <button class="list-link" bindtap="go" data-url="/pages/admin-review/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/shield.svg" aria-hidden="true" /><text class="grow">内容审核</text><image class="icon-small"
            src="/static/campus/next.svg" aria-hidden="true" /></button>
        <button class="list-link" bindtap="go" data-url="/pages/admin-members/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/users.svg" aria-hidden="true" /><text class="grow">内测成员管理</text><image
            class="icon-small" src="/static/campus/next.svg" aria-hidden="true" /></button>
      </view>
    </block>
    <button class="list-link" bindtap="go" data-url="/pages/setting/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
        src="/static/campus/settings.svg" aria-hidden="true" /><text class="grow">设置与帮助</text><image class="icon-small"
        src="/static/campus/next.svg" aria-hidden="true" /></button>
  </view>
</view>
