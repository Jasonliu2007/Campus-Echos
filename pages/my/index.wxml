<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <campus-hero reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" title="{{member ? member.nickname : '我的校园回声'}}" personal-title="{{!!member}}"
    subtitle="{{member && member.role === 'admin' ? '封闭内测成员 · 管理员' : accessLabel}}" icon="user" />
  <view class="content tab-content">
    <view wx:if="{{sessionNotice}}" class="notice">{{sessionNotice}}</view>
    <button class="list-link" bindtap="login" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/user.svg" aria-hidden="true"/><view class="grow"><view class="name">{{authenticated ? '微信账号已识别' : '微信账号登录'}}</view><view class="sub">{{member.role === 'admin' ? '管理权限已自动识别，无需另外登录' : '使用当前微信账号，查看你的内测资格'}}</view></view><text class="tag">{{authenticated ? '核对身份' : '微信登录'}}</text></button>
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:if="{{loading}}" kind="loading" title="正在获取资格" description="正在核对当前微信账号的内测状态。" />
    <campus-state reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}" wx:elif="{{error}}" kind="error" title="资格暂时无法加载" description="{{error}}" action="重新加载"
      bind:action="refresh" />
    <block wx:else>
      <view class="profile-summary">
        <view class="avatar" aria-hidden="true">{{member && member.nickname ? member.nickname[0] : '同'}}</view>
        <view class="grow">
          <view class="profile-name">{{member ? member.nickname : '校园同学'}}</view>
          <view class="sub profile-meta">{{accessLabel}}</view>
          <text wx:if="{{member && member.role === 'admin'}}" class="tag">管理员</text>
        </view>
        <image class="icon" src="/static/campus/user.svg" aria-hidden="true" />
      </view>
      <button class="list-link" bindtap="goAccess" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/shield.svg"
          aria-hidden="true" />
        <view class="grow">
          <view class="name">封闭内测资格</view>
          <view class="sub">{{accessLabel}}</view>
        </view><image class="icon-small" src="/static/campus/next.svg" aria-hidden="true" />
      </button>
      <button wx:if="{{access === 'approved' && campusEmailSupported}}" class="list-link" bindtap="go" data-url="/pages/campus-email/index">
        <image class="icon" src="/static/campus/shield.svg" aria-hidden="true" />
        <view class="grow"><view class="name">学校邮箱</view><view class="sub">{{campusEmailVerified ? '已验证' : '验证 @mail.bnbu.edu.cn 邮箱'}}</view></view>
        <image class="icon-small" src="/static/campus/next.svg" aria-hidden="true" />
      </button>
      <view class="section">
        <view class="section-head"><text class="section-title">学习资料</text><text class="sub">真实订单与资料</text></view>
        <view class="grid-two">
          <button class="tile" bindtap="go" data-url="/pages/trade-orders/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/bag.svg"
              aria-hidden="true" />已购笔记</button>
          <button class="tile" bindtap="go" data-url="/pages/my-materials/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
              src="/static/campus/file.svg" aria-hidden="true" />我上架的资料</button>
        </view>
      </view>
      <view class="section">
        <view class="section-head"><text class="section-title">校园与活动</text></view>
        <view class="function-group">
        <button class="list-link" bindtap="go" data-url="/pages/my-posts/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/wall.svg" aria-hidden="true" /><text class="grow">我的帖子</text><image class="icon-small"
            src="/static/campus/next.svg" aria-hidden="true" /></button>
        <button class="list-link" bindtap="go" data-url="/pages/my-reports/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/shield.svg" aria-hidden="true" /><text class="grow">我的举报</text><image class="icon-small" src="/static/campus/next.svg" aria-hidden="true" /></button>
        <button class="list-link" bindtap="unavailable" data-label="我创建的活动" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/calendar.svg" aria-hidden="true" /><text class="grow">我创建的活动</text><text
            class="demo">演示</text></button>
        <button class="list-link" bindtap="unavailable" data-label="我加入的活动" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/users.svg" aria-hidden="true" /><text class="grow">我加入的活动</text><text
            class="demo">演示</text></button>
        </view>
      </view>
      <view wx:if="{{member.role === 'admin' && access === 'approved'}}" class="section">
        <view class="section-head"><text class="section-title">管理工作台</text><text class="sub">仅管理员可见</text></view>
        <button class="list-link" bindtap="go" data-url="/pages/admin-trade/index"><image class="icon" src="/static/campus/book.svg" aria-hidden="true"/><text class="grow">资料审核与交易协调</text><image class="icon-small" src="/static/campus/next.svg" aria-hidden="true"/></button>
        <view class="function-group">
        <button class="list-link" bindtap="go" data-url="/pages/admin-review/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/shield.svg" aria-hidden="true" /><text class="grow">内容审核</text><image class="icon-small"
            src="/static/campus/next.svg" aria-hidden="true" /></button>
        <button class="list-link" bindtap="go" data-url="/pages/admin-reports/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon" src="/static/campus/shield.svg" aria-hidden="true" /><text class="grow">举报处理</text><image class="icon-small" src="/static/campus/next.svg" aria-hidden="true" /></button>
        <button class="list-link" bindtap="go" data-url="/pages/admin-members/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
            src="/static/campus/users.svg" aria-hidden="true" /><text class="grow">成员与管理员授权</text><image
            class="icon-small" src="/static/campus/next.svg" aria-hidden="true" /></button>
        </view>
      </view>
    </block>
    <button class="list-link" bindtap="go" data-url="/pages/setting/index" hover-class="press" hover-start-time="0" hover-stay-time="120"><image class="icon"
        src="/static/campus/settings.svg" aria-hidden="true" /><text class="grow">设置与帮助</text><image class="icon-small"
        src="/static/campus/next.svg" aria-hidden="true" /></button>
  </view>
</view>
