.material-content{max-width:1040rpx;margin:auto}.material-cover{background:linear-gradient(140deg,#F4FBFF,#C3E4F8 72%,#E6F6FF);padding:36rpx;border:2rpx solid #fff;border-radius:42rpx;box-shadow:0 14rpx 32rpx rgba(45,106,148,.09),inset 0 3rpx #fff}.cover-top,.cover-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-wrap:wrap;color:#42647E;font-size:24rpx}.cover-top image{width:48rpx;height:48rpx}.cover-course{font-size:26rpx;letter-spacing:4rpx;margin-top:56rpx}.material-title{font-size:46rpx;font-weight:750;line-height:1.5;margin:16rpx 0 48rpx;word-break:break-word}.cover-bottom{border-top:2rpx solid rgba(66,100,126,.18);padding-top:24rpx}.material-summary{padding:36rpx 8rpx}.summary-text{font-size:32rpx;line-height:1.8;margin:16rpx 0}.material-jumps{margin-bottom:36rpx}.contents-panel{padding:30rpx}.toc-row{display:flex;align-items:center;gap:20rpx;width:100%;min-height:56px;padding:24rpx 12rpx;background:transparent;border-radius:18rpx;color:#18344F;text-align:left;font-size:28rpx;transition:background-color 160ms,transform 120ms,opacity 120ms}.toc-row+.toc-row{border-top:2rpx solid #E0ECF4}.toc-row.selected{background:#E9F5FD}.toc-row image{width:32rpx;height:32rpx;flex:none}.toc-number{font-size:24rpx;color:#42647E;font-variant-numeric:tabular-nums}.preview-heading{margin:44rpx 4rpx 24rpx}.sample-paper{padding:36rpx;background:#FCFEFF;border:2rpx solid #fff;border-radius:34rpx;margin:0 0 28rpx;box-shadow:0 10rpx 30rpx rgba(45,106,148,.06)}.paper-running,.paper-footer{display:flex;justify-content:space-between;gap:16rpx;flex-wrap:wrap;font-size:23rpx;color:#4D6E88}.paper-running{padding-bottom:24rpx;border-bottom:2rpx solid #DEEAF3}.paper-number{font-size:72rpx;font-weight:600;color:#B7D5E9;line-height:1.2;margin-top:36rpx}.paper-title{font-size:40rpx;font-weight:750;line-height:1.5;margin:12rpx 0 28rpx}.paper-paragraph{line-height:1.95;font-size:31rpx}.paper-note{margin:32rpx 0;padding:26rpx;border-left:6rpx solid #7CBADD;border-radius:0 20rpx 20rpx 0;background:#EDF7FE;font-size:30rpx;line-height:1.8;white-space:pre-wrap}.paper-label{font-size:24rpx;color:#42647E;margin:32rpx 0 20rpx;letter-spacing:2rpx}.paper-point{display:flex;align-items:flex-start;gap:18rpx;margin-bottom:22rpx;line-height:1.8;font-size:28rpx}.point-number{width:40rpx;flex:none;border-radius:12rpx;background:#EAF4FC;text-align:center;font-size:24rpx;line-height:40rpx}.paper-footer{margin-top:40rpx;padding-top:24rpx;border-top:2rpx solid #DEEAF3}.solid .material-cover{background:#F9FCFF;border-color:#C6DCEC}.reduced .toc-row{transition:none}@media(max-width:350px){.material-cover,.sample-paper{padding:28rpx}.material-title{font-size:42rpx}.paper-title{font-size:36rpx}}@media(prefers-reduced-motion:reduce){.toc-row{transition:none}}
