@import "../../components/campus-post/content.wxss";
@import "../../components/campus-ui/page.wxss";

.layout-toolbar{margin-top:32rpx;padding:24rpx;border:2rpx solid #D6E7F3;background:#F0F8FE;border-radius:28rpx}.symbol-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;margin-top:24rpx}.symbol-button{min-height:44px;display:flex;align-items:center;justify-content:center;background:#FCFEFF;border:2rpx solid #D0E5F3;color:#18344F;font-size:36rpx;border-radius:20rpx;transition:transform 120ms,opacity 120ms}.template-card{margin-top:24rpx;padding:24rpx;background:#FCFEFF;border-radius:24rpx}.layout-shortcuts{margin:12rpx 0}.layout-toolbar .sub{font-size:24rpx}.reduced .symbol-button{transition:none}@media(prefers-reduced-motion:reduce){.symbol-button{transition:none}}

.media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin:20rpx 0}.media-tile{min-width:0;border:2rpx solid #D6E7F3;border-radius:24rpx;padding:12rpx;background:#F7FCFF}.media-tile image{width:100%;height:160rpx;border-radius:16rpx}.media-tile .sub{font-size:22rpx;line-height:1.6;word-break:break-word}.media-tile .text-button{font-size:24rpx;padding:8rpx;min-height:44px}@media(max-width:350px){.media-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
.preset-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; margin: 16rpx 0; }
.cover-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.preset-choice { min-width: 0; min-height: 44px; padding: 10rpx 4rpx; font-size: 23rpx; background: #EDF7FF; color: #254862; border-radius: 16rpx; }
.preset-choice image { display: block; margin: 0 auto 6rpx; }
.cover-grid image, .preset-cover { width: 100%; height: 100rpx; border-radius: 12rpx; }
.preset-cover { width: 210rpx; margin-top: 12rpx; }

.compose-header { display:grid; grid-template-columns: 1fr auto 1fr; align-items:center; min-height:104rpx; padding:0 24rpx; border-bottom:1px solid #D5E7F3; font-size:33rpx; font-weight:700; }
.compose-header > button { justify-self:start; }
.compose-header-tools { display:flex; justify-self:end; align-items:center; background:#F9FCFF; border:1px solid #D5E7F3; border-radius:50rpx; }
.compose-button { min-height:44px; min-width:44px; display:inline-flex; align-items:center; justify-content:center; padding:0 10rpx; background:transparent; color:#4D6E88; font-size:28rpx; }
.compose-button image { width:39rpx; height:39rpx; }
.compose-scroll { padding:24rpx 20rpx 180rpx; }
.compose-line { display:grid; grid-template-columns:76rpx minmax(0,1fr); gap:16rpx; }
.compose-rail { display:flex; flex-direction:column; align-items:center; }
.compose-rail .avatar-button { min-width:0; min-height:0; padding:0; }
.avatar-button .post-avatar { display:block; width:76rpx; height:76rpx; }
.compose-stem { flex:1; margin:8rpx 0; width:3rpx; background:#BDD6E7; }
.compose-byline { display:flex; flex-wrap:wrap; align-items:baseline; gap:8rpx; font-size:28rpx; color:#4D6E88; margin-bottom:3rpx; }
.compose-author { font-weight:700; color:#18344F; overflow-wrap:anywhere; }
.compose-title-field, .compose-body { display:block; width:100%; padding:0; color:#18344F; background:transparent; border:0; font-size:30rpx; }
.compose-title-field { min-height:42rpx; font-weight:700; }
.compose-body { min-height:46rpx; line-height:1.5; }
.compose-tools { position:relative; display:flex; gap:7rpx; margin:12rpx 0 14rpx; }
.compose-menu { position:absolute; z-index:8; inset-inline-start:0; top:90%; width:min(390rpx,100%); padding:10rpx 14rpx; border:1px solid #fff; background:#F4FAFF; border-radius:36rpx; box-shadow:0 14rpx 38rpx rgba(24,52,79,.17); }
.compose-menu button { display:flex; min-height:44px; gap:17rpx; align-items:center; width:100%; background:transparent; color:#18344F; padding:0 14rpx; }
.compose-menu image { width:33rpx; height:33rpx; }
.compose-add-thread { display:flex; align-items:center; justify-content:flex-start; gap:21rpx; min-height:44px; padding:0 0 0 19rpx; background:transparent; color:#4D6E88; }
.compose-add-thread image { width:36rpx; height:36rpx; border-radius:50%; }
.compose-footer { position:fixed; z-index:9; bottom:0; left:0; right:0; display:flex; align-items:center; gap:10rpx; min-height:70rpx; padding:10rpx 17rpx calc(10rpx + env(safe-area-inset-bottom)); background:#E8F5FC; border-top:1px solid #D5E7F3; }
.compose-footer.above-keyboard { padding-bottom:10rpx; }
.compose-options { gap:8rpx; margin-right:auto; white-space:nowrap; }
.compose-identity { display:flex; align-items:center; gap:7rpx; min-height:44px; padding:0 13rpx; border-radius:50rpx; color:#315774; background:#D8EBF8; font-size:24rpx; white-space:nowrap; }
.compose-identity.is-anonymous { background:#C9E5F8; }
.compose-identity image { width:35rpx; height:35rpx; border-radius:50%; }
.compose-post { min-height:44px; min-width:100rpx; border-radius:55rpx; padding:0 18rpx; white-space:nowrap; }
.compose-mask { position:fixed; inset:0; z-index:20; display:flex; justify-content:center; align-items:flex-end; background:rgba(15,38,55,.35); padding:16rpx 14rpx calc(16rpx + env(safe-area-inset-bottom)); }
.compose-sheet { width:100%; max-height:79vh; overflow-y:auto; padding:10rpx 32rpx 28rpx; box-sizing:border-box; border:1px solid #fff; border-radius:58rpx; background:#EEF8FF; }
.sheet-handle { width:88rpx; height:7rpx; margin:0 auto 28rpx; background:#A6C8DE; border-radius:8rpx; }
.sheet-label { margin:14rpx 0 12rpx; color:#4D6E88; font-size:25rpx; font-weight:650; }
.sheet-group { padding:0 24rpx; border-radius:30rpx; background:#FCFEFF; }
.sheet-row { display:flex; justify-content:space-between; align-items:center; width:100%; min-height:76rpx; padding:10rpx 0; color:#18344F; background:transparent; text-align:left; font-size:29rpx; }
.sheet-row + .sheet-row { border-top:1px solid #DAEAF5; }
.sheet-radio { width:32rpx; height:32rpx; border:2rpx solid #8FB4CB; border-radius:50%; }
.sheet-radio.checked { border:4rpx solid #0878BD; background:#0878BD; box-shadow:inset 0 0 0 4rpx #fff; }
.spaced { margin:20rpx 0 22rpx; }
.sheet-note { padding:0 0 16rpx; color:#4D6E88; font-size:25rpx; }
.sheet-done { width:100%; margin-top:24rpx; min-height:82rpx; }
.sheet-input { margin-bottom:10rpx; }
.sticker-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:8rpx; }
.sticker-grid button { padding:0; background:transparent; min-height:44px; min-width:0; }
.sticker-grid image { display:block; width:100%; height:70rpx; }
.compose-attachment { display:flex; justify-content:space-between; align-items:center; gap:12rpx; margin:10rpx 0; }
.compose-sticker { width:124rpx; height:124rpx; }
@media(max-width:350px) { .sticker-grid { grid-template-columns:repeat(5,minmax(0,1fr)); } .compose-footer { gap:4rpx; } .compose-button,.compose-identity { padding-left:6rpx; padding-right:6rpx; } }
