<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}"><view class="content with-actions trade-wrap">
 <campus-state wx:if="{{loading}}" kind="loading" title="正在核对管理权限" reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}"/>
 <campus-state wx:elif="{{!allowed || !material}}" kind="error" title="暂时无法核查资料" description="{{error}}" action="重新核对" bind:action="retry" reduced-motion="{{reducedMotion}}" reduced-transparency="{{reducedTransparency}}"/>
 <block wx:else>
  <view class="trade-head"><view class="section-caption">校园回声 / 私有审核</view><view class="trade-title">看完整，再决定</view><view class="trade-note">仅管理员核查全量文件，访问留审计。</view></view>
  <view class="notice warning">微信明确违规时不能人工放行。独立试读不代替全量核查；不得转发私有完整原件。</view>
  <view class="trade-panel"><view class="trade-row"><text class="trade-status">{{material.statusLabel}}</text><text class="sub">版本 {{material.revision}}</text><button class="text-button" bindtap="retry" disabled="{{!!busy}}">刷新</button></view><view class="trade-title">{{material.title}}</view><view class="trade-note">{{material.course}} / {{material.type}} / {{material.pageCount}}页</view><view class="trade-value">{{material.description}}</view><view class="trade-note">{{material.displayPrice}} · {{material.displayTime}}</view><view wx:if="{{material.reviewReason}}" class="notice warning">已有审核说明：{{material.reviewReason}}</view><view class="trade-divider"/><view class="section-title">发布者确认目录</view><view wx:for="{{material.catalog}}" wx:key="index" class="trade-row"><text class="grow">{{index + 1}}. {{item.title}}</text><text class="sub">P.{{item.page}}</text></view><button class="secondary full" bindtap="document" loading="{{busy === 'document'}}" disabled="{{!!busy}}">核对完整PDF（微信原生阅读）</button><view wx:if="{{documentOpened}}" class="trade-note">完整文件已打开，仍需人工逐页核查并确认。</view></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{error}}" class="notice error" aria-role="alert">{{error}}</view><view wx:if="{{conflict}}" class="notice warning">资料状态有变化，已清除旧核查勾选。处理说明保留，请核对最新版本后重新确认。</view>
  <view wx:if="{{material.status === 'pending'}}" class="trade-panel"><view class="section-title">核查结论</view><checkbox-group bindchange="check"><label class="trade-check"><checkbox value="copyright" checked="{{copyrightChecked}}" disabled="{{!!busy}}" color="#0878BD"/><text>已核查原创声明、发布权利与必要来源。</text></label><label class="trade-check"><checkbox value="description" checked="{{descriptionChecked}}" disabled="{{!!busy}}" color="#0878BD"/><text>已核对目录、页数、标题及描述一致性。</text></label><label class="trade-check"><checkbox value="document" checked="{{fullDocumentChecked}}" disabled="{{!!busy}}" color="#0878BD"/><text>已打开并逐页核查完整PDF，未以试读代替全量核查。</text></label></checkbox-group><label class="trade-label" for="material-review-reason">处理说明（2–200字）</label><textarea id="material-review-reason" class="trade-textarea" value="{{reason}}" bindinput="input" disabled="{{!!busy}}" maxlength="-1" cursor-spacing="28" adjust-position="{{true}}" aria-label="资料审核处理说明，2到200字"/><view class="trade-counter">{{reasonCount}} / 200</view><view class="trade-note">批准与驳回都必须填写，失败或冲突时保留输入。</view></view>
  <view wx:else class="trade-panel"><view class="trade-value">这份资料当前不在待审状态。</view><view class="trade-note">不能重复处置或覆盖已完成结果。可返回工作台查看其他待审资料。</view></view>
 </block>
 </view><view class="sticky-actions"><button wx:if="{{allowed && material.status === 'pending'}}" class="secondary danger-text" bindtap="review" data-decision="reject" disabled="{{!!busy}}" loading="{{busy === 'review'}}">驳回补充</button><button wx:if="{{allowed && material.status === 'pending'}}" class="primary" bindtap="review" data-decision="approve" disabled="{{!!busy}}" loading="{{busy === 'review'}}">核查后上架</button><button wx:else class="primary full" bindtap="back">返回工作台</button></view>
</view>
