<view class="page {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}">
  <view class="content">
    <scroll-view class="chip-scroll" scroll-x>
      <view class="chip-list">
        <button wx:for="{{filters}}" wx:key="value" class="chip {{filter === item.value ? 'active' : ''}}"
          aria-label="{{item.label}}，{{filter === item.value ? '已选择' : '未选择'}}" data-value="{{item.value}}" bindtap="changeFilter" hover-class="press" hover-start-time="0" hover-stay-time="120">{{item.label}}</button>
      </view>
    </scroll-view>
    <campus-state wx:if="{{loading && !items.length}}" kind="loading" title="正在加载" description="正在连接校园回声，请稍候。" />
    <campus-state wx:elif="{{error && !items.length}}" kind="error" title="暂时没能加载" description="{{error}}" action="重新加载"
      bind:action="retry" />
    <campus-state wx:if="{{!loading && access !== 'approved' && access !== 'error'}}" kind="access"
      title="{{access === 'pending' ? '内测申请正在审核' : access === 'revoked' ? '内测资格已撤销' : '校园墙正在封闭内测'}}"
      description="{{access === 'pending' ? '管理员批准后即可阅读和发布校园墙内容。' : '仅获准账号可以使用真实校园墙。内测资格不代表学生实名认证。'}}" action="查看内测资格"
      bind:action="goAccess" />
    <block wx:if="{{access === 'approved' && (items.length || (!loading && !error))}}">
      <campus-state wx:if="{{!items.length}}" title="这里还没有帖子" description="你发布的内容和审核结果都会留在这里。" action="发布文字帖"
        bind:action="publish" />
      <view wx:if="{{loading && items.length}}" class="notice">正在刷新，已加载内容保留。</view>
      <view wx:if="{{error && items.length}}" class="notice error">{{error}}
        <button class="text-button" bindtap="retry" hover-class="press" hover-start-time="0" hover-stay-time="120">重新加载</button>
      </view>
      <campus-post reduced-motion="{{reducedMotion}}" wx:for="{{items}}" wx:key="_id" post="{{item}}" show-status bind:open="openPost" />
      <view wx:if="{{items.length}}">
        <view wx:if="{{pageError}}" class="notice error">{{pageError}}</view>
        <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" disabled="{{loadingMore}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
          {{loadingMore ? '正在加载更多…' : pageError ? '重试加载下一页' : '加载下一页'}}</button>
        <view wx:else class="footnote">已经看到全部内容</view>
      </view>
    </block>
  </view>
</view>
