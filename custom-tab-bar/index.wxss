/* v2.1: one persistent lens moves; icons and labels never stretch. */
:host { background: transparent; }
.tabs {
  position: fixed; bottom: 12rpx; bottom: calc(12rpx + env(safe-area-inset-bottom));
  left: 24rpx; right: 24rpx; z-index: 50; box-sizing: border-box;
  padding: 12rpx; border: 2rpx solid rgba(255,255,255,.88); border-radius: 64rpx;
  background: linear-gradient(145deg, #F5FAFD, #E7F3FB);
  box-shadow: 0 14rpx 38rpx rgba(42,93,123,.08), inset 0 2rpx 2rpx rgba(255,255,255,.98), inset 0 -2rpx 2rpx rgba(156,189,214,.16);
}
.tab-track { position: relative; display: flex; width: 100%; }
.tab-lens {
  position: absolute; z-index: 0; left: 0; top: 0; bottom: 0; width: 20%;
  box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.95); border-radius: 54rpx;
  background: linear-gradient(145deg, rgba(255,255,255,.56), rgba(255,255,255,.22) 50%, rgba(206,234,249,.34));
  box-shadow: 0 6rpx 16rpx rgba(53,108,140,.10), inset 0 2rpx 4rpx #fff, inset 0 -2rpx 4rpx rgba(165,214,237,.40);
  overflow: hidden; pointer-events: none;
  transition: transform 260ms cubic-bezier(.25,1,.5,1);
}
.lens-sheen { position: absolute; top: 2rpx; right: 2rpx; bottom: 2rpx; left: 2rpx; border-radius: inherit; background: linear-gradient(112deg, transparent 20%,rgba(255,255,255,.58) 36%,transparent 52%); opacity: .65; pointer-events: none; }
.tab {
  position: relative; z-index: 1; flex: 1; min-width: 0; box-sizing: border-box;
  min-height: 44px; min-height: max(44px,106rpx); margin: 0; padding: 8rpx 2rpx;
  border: 0; background: transparent; color: #47667E; border-radius: 54rpx;
  display: flex; align-items: center; flex-direction: column; justify-content: center; gap: 6rpx;
  font-size: 24rpx; line-height: 1.4;
}
.tab::after { border: 0; }
.icon-wrap { width: 64rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; }
.tab image { width: 42rpx; height: 42rpx; }
.tabs.solid { background: #F9FCFF; border-color: #C6DCEC; }
.solid .tab-lens { background:#E0F0FA; border-color:#ADC8DA; box-shadow:none; }
.initial .tab-lens, .reduced .tab-lens { transition: none; }
@media(prefers-reduced-motion:reduce) { .tab-lens { transition:none; } }
@media(prefers-reduced-transparency:reduce) { .tabs { background:#F9FCFF; } .tab-lens { background:#E0F0FA; } }
