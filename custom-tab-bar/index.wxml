<view class="tabs {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}" aria-role="group" aria-label="主导航">
  <button wx:for="{{items}}" wx:key="path" class="tab {{active === item.path ? 'active' : ''}}"
    data-path="{{item.path}}" bindtap="switchTab" aria-role="button" aria-selected="{{active === item.path}}"
    aria-label="{{item.label}}，{{active === item.path ? '当前页面' : '未选择'}}" hover-class="press" hover-start-time="0" hover-stay-time="120">
    <view class="icon-wrap"><image src="/static/campus/{{item.icon}}.svg" aria-hidden="true" /></view>
    <text>{{item.label}}</text>
  </button>
</view>
