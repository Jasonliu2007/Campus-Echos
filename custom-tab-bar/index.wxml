<view class="tabs {{motionReady ? '' : 'initial'}} {{reducedMotion ? 'reduced' : ''}} {{reducedTransparency ? 'solid' : ''}}" aria-role="group" aria-label="主导航">
  <view class="tab-track">
    <view wx:if="{{active}}" class="tab-lens" style="transform:translate3d({{indicatorIndex * 100}}%,0,0)" aria-hidden="true"><view class="lens-sheen" /></view>
    <button wx:for="{{items}}" wx:key="path" class="tab"
      data-path="{{item.path}}" bindtap="switchTab" aria-role="button" aria-selected="{{active === item.path}}"
      aria-label="{{item.label}}，{{active === item.path ? '当前页面' : '未选择'}}">
      <view class="icon-wrap"><image src="/static/campus/{{item.icon}}.svg" aria-hidden="true" /></view>
      <text>{{item.label}}</text>
    </button>
  </view>
</view>
