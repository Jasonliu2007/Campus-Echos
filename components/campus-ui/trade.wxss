@import "./page.wxss";
.trade-wrap{max-width:1040rpx;margin:0 auto}.trade-head{padding:20rpx 0 28rpx}.trade-title{font-size:42rpx;font-weight:750;line-height:1.5}.trade-panel{background:rgba(255,255,255,.78);border:2rpx solid rgba(255,255,255,.94);border-radius:32rpx;padding:30rpx;margin-bottom:24rpx;box-shadow:0 10rpx 28rpx rgba(44,102,144,.06)}.trade-label{display:block;font-size:27rpx;font-weight:650;margin:28rpx 0 12rpx}.trade-input,.trade-textarea{box-sizing:border-box;width:100%;min-height:96rpx;padding:22rpx 24rpx;border:2rpx solid #CDDFEB;border-radius:20rpx;background:#FBFDFF;font-size:16px;color:#193B54}.trade-textarea{min-height:240rpx;line-height:1.8}.trade-input:focus,.trade-textarea:focus{border-color:#3987B8}.trade-counter{text-align:right;font-size:24rpx;color:#48697F;margin:10rpx 0}.trade-note{font-size:26rpx;line-height:1.8;color:#48697F;white-space:pre-wrap;word-break:break-word}.trade-value{font-size:30rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word}.trade-row{display:flex;align-items:center;gap:18rpx;flex-wrap:wrap;min-height:88rpx}.trade-row .grow{min-width:140rpx}.trade-price{font-size:42rpx;font-weight:700;color:#086DAB}.trade-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.trade-chip{min-height:88rpx;padding:18rpx;border:2rpx solid #CFE2F0;border-radius:22rpx;background:#F6FBFF;font-size:27rpx;color:#264B64}.trade-chip.selected{background:#DDEFFB;border-color:#62ACC9;color:#075E79}.trade-list{display:block;width:100%;text-align:left;border-radius:28rpx;padding:26rpx;background:rgba(255,255,255,.8);margin-bottom:20rpx;min-height:104rpx;color:#1A3B53;font-size:30rpx;white-space:normal}.trade-list-title{font-size:32rpx;font-weight:650;line-height:1.6;word-break:break-word}.trade-divider{height:2rpx;background:#DBE9F3;margin:24rpx 0}.trade-status{display:inline-block;padding:8rpx 18rpx;border-radius:16rpx;background:#EAF6FE;color:#086DAB;font-size:24rpx}.trade-progress{height:12rpx;border-radius:12rpx;background:#DFEDF7;overflow:hidden;margin:22rpx 0}.trade-progress-fill{height:100%;background:#6EBCD8;transition:transform 160ms ease-out;transform-origin:left}.trade-qr{display:block;width:460rpx;height:460rpx;max-width:100%;margin:24rpx auto;background:#F7FBFF;border-radius:22rpx}.trade-message{padding:22rpx;border-radius:22rpx;background:#F3F9FE;margin:16rpx 0}.trade-check{display:flex;align-items:flex-start;gap:14rpx;min-height:88rpx;font-size:28rpx;line-height:1.7;margin-top:12rpx}.trade-footer{padding:20rpx 0 8rpx;font-size:24rpx;color:#48697F;line-height:1.8}.trade-panel .row button{min-width:0}.solid .trade-panel{background:#FAFDFF;border-color:#C5DCEB}.reduced .trade-progress-fill{transition:none}@media(max-width:350px){.trade-panel{padding:24rpx}.trade-grid{grid-template-columns:1fr}.trade-title{font-size:38rpx}}@media(prefers-reduced-motion:reduce){.trade-progress-fill{transition:none}}

/* Preserve readable inputs and touch areas on narrow devices. */
.trade-chip,.trade-row,.trade-check{min-height:44px}
