@import "./tokens.wxss";

page {
  background: #DFEFFA;
  background-image: radial-gradient(ellipse at 5% 0%, rgba(255, 255, 255, .90), transparent 48%), linear-gradient(165deg, #DAEDFC 0%, #F1F9FF 46%, #DFEFFA 100%);
  background-attachment: fixed;
  background-size: 100vw 100vh;
  background-repeat: no-repeat;
  color: var(--ce-ink, #18344F);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--ce-font-body, 30rpx);
  line-height: 1.6
}

view,
text,
label,
button,
input,
textarea {
  box-sizing: border-box
}

button {
  font-family: inherit;
  margin: 0;
  line-height: 1.45;
  font-size: 28rpx;
  border-radius: 30rpx
}

button::after {
  border: 0
}

button[disabled] {
  opacity: .5
}

button:focus {
  outline: 4rpx solid #75BDEA;
  outline-offset: 3rpx
}

.page {
  min-height: 100vh;
  background: transparent;
}

.content {
  padding: 32rpx var(--ce-space-page, 32rpx) calc(32rpx + env(safe-area-inset-bottom))
}

.tab-content {
  padding-bottom: calc(236rpx + env(safe-area-inset-bottom))
}

.with-actions {
  padding-bottom: calc(236rpx + env(safe-area-inset-bottom))
}

.row,
.between,
.meta,
.toolbar,
.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx
}

.between,
.toolbar,
.section-head {
  justify-content: space-between
}

.row-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx
}

.grow {
  flex: 1;
  min-width: 0
}

.section {
  margin-bottom: 40rpx
}

.section-head {
  margin-bottom: 20rpx
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.4
}

.sub,
.help-copy {
  font-size: 26rpx;
  color: var(--ce-muted, #4D6E88)
}

.help-copy {
  line-height: 1.8
}

.muted {
  color: var(--ce-muted, #4D6E88)
}

.icon {
  width: 40rpx;
  height: 40rpx;
  flex: none
}

.icon-small {
  width: 32rpx;
  height: 32rpx
}

.card {
  background: var(--ce-content, #F9FCFF);
  border: 2rpx solid rgba(255, 255, 255, .96);
  border-radius: var(--ce-radius-card, 38rpx);
  box-shadow: var(--ce-shadow-card, 0 10rpx 28rpx rgba(45, 106, 148, .08));
  padding: var(--ce-space-card, 28rpx);
  margin-bottom: var(--ce-space-stack, 24rpx)
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.55;
  margin: 20rpx 0 12rpx;
  word-break: break-word
}

.card-copy {
  color: var(--ce-muted, #4D6E88);
  line-height: 1.7;
  word-break: break-word
}

.notice {
  padding: 22rpx 24rpx;
  border: 2rpx solid #D5E4EE;
  border-radius: 26rpx;
  background: rgba(236, 248, 255, .9);
  color: #24577C;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx
}

.notice.warning {
  background: #FFF5DC;
  border-color: #EAD6A0;
  color: #775A1E
}

.notice.error {
  background: #FFF0F1;
  border-color: #EAC6CB;
  color: #A13140
}

.notice.success {
  background: #E8F8F3;
  border-color: #AADCD0;
  color: #087D72
}

.primary,
.secondary,
.danger {
  min-height: 44px;
  padding: 20rpx 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 120ms cubic-bezier(.22, 1, .36, 1), opacity 120ms, background-color 120ms
}

.primary {
  background: linear-gradient(172deg, #72D3FF 0%, #1689D5 10%, #0878BD 22%, #0769AD 72%, #0878BD 88%, #35BDF4 100%);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, .92);
  box-shadow: 0 10rpx 22rpx rgba(10, 123, 190, .22), inset 0 3rpx 4rpx rgba(255, 255, 255, .65), inset 0 -3rpx 5rpx rgba(74, 214, 255, .78);
}

.secondary {
  background: linear-gradient(155deg, rgba(255, 255, 255, .92), rgba(225, 244, 255, .86));
  color: #24577C;
  border: 2rpx solid #fff;
  box-shadow: inset 0 2rpx 0 #fff, 0 5rpx 14rpx rgba(49, 112, 158, .08);
}

.danger {
  background: #A93546;
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, .8);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .28);
}

.press {
  transition-duration: 60ms;
  transform: scale(.98);
  opacity: .94
}

.full {
  width: 100%;
  margin-top: 20rpx
}

.small-button {
  min-height: 44px;
  padding: 16rpx 24rpx
}

.text-button {
  min-width: 44px;
  background: transparent;
  color: #0878BD;
  min-height: 44px;
  padding: 16rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx
}

.danger-text {
  color: #B83D49
}

.search {
  background: linear-gradient(155deg, rgba(255, 255, 255, .92), rgba(219, 240, 255, .88));
  border: 2rpx solid rgba(255, 255, 255, .98);
  box-shadow: 0 10rpx 24rpx rgba(40, 112, 157, .12), inset 0 3rpx 4rpx rgba(255, 255, 255, .96), inset 0 -2rpx 3rpx rgba(255, 255, 255, .75);
  border-radius: 50rpx;
  min-height: 48px;
  padding: 18rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--ce-muted, #4D6E88);
  width: 100%;
  text-align: left;
  margin-bottom: 24rpx
}

.toolbar {
  margin-bottom: 20rpx
}

.chip-scroll {
  white-space: nowrap;
  margin-top: -16rpx;
  margin-bottom: 0;
  width: 100%;
  background: transparent;
}

.chip-list {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 4rpx 32rpx;
}

.chip {
  min-height: 44px;
  flex: none;
  padding: 18rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, .96);
  border-radius: 46rpx;
  background: linear-gradient(155deg, rgba(255, 255, 255, .92), rgba(224, 243, 255, .82));
  box-shadow: 0 4rpx 10rpx rgba(44, 116, 159, .045), inset 0 2rpx 0 #fff;
  color: #355873;
  transition: background-color 160ms, color 160ms, border-color 160ms, transform 120ms cubic-bezier(.22, 1, .36, 1), opacity 120ms
}

.chip.active {
  background: linear-gradient(170deg, #68CDFB 0%, #0878BD 22%, #0878BD 78%, #38BEF3 100%);
  border-color: rgba(255, 255, 255, .98);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(17, 127, 195, .10), inset 0 2rpx 3rpx rgba(255, 255, 255, .8);
}

.tag {
  font-size: 24rpx;
  line-height: 1.5;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  color: #42647E;
  background: #EEF6FC;
  display: inline-block
}

.tag.pending {
  background: #FFF2CC;
  color: #7D5C13
}

.tag.success {
  background: #E2F6ED;
  color: #087D72
}

.tag.rejected,
.tag.hidden,
.tag.deleted {
  background: #FCECEF;
  color: #A23848
}

.avatar {
  height: 76rpx;
  width: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #EDF9FF, #BCDFF6);
  border: 2rpx solid #fff;
  box-shadow: 0 5rpx 12rpx rgba(36, 116, 169, .12), inset 0 2rpx 0 #fff;
  color: #2270A2;
  font-size: 32rpx;
  font-weight: 700;
  flex: none
}

.name {
  font-size: 28rpx;
  font-weight: 600
}

.rule {
  height: 2rpx;
  background: #DCEAF4;
  margin: 28rpx 0
}

.footnote {
  color: var(--ce-muted, #4D6E88);
  text-align: center;
  font-size: 24rpx;
  padding: 22rpx 0
}

.list-link {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  text-align: left;
  background: linear-gradient(150deg, #FFFFFF, #F0F8FE);
  border: 2rpx solid rgba(255, 255, 255, .96);
  border-radius: 30rpx;
  box-shadow: 0 6rpx 18rpx rgba(48, 108, 149, .07), inset 0 2rpx 0 #fff;
  padding: 26rpx;
  min-height: 56px;
  margin-bottom: 16rpx;
  color: #102D46
}

.next {
  margin-left: auto
}

.grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx
}

.tile {
  background: linear-gradient(145deg, #F9FDFF, #E4F2FC);
  border: 2rpx solid #fff;
  box-shadow: 0 8rpx 20rpx rgba(42, 116, 160, .08), inset 0 2rpx 0 #fff;
  padding: 26rpx 20rpx;
  min-height: 80px;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  justify-content: center;
  color: #102D46
}

.label {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin: 28rpx 0 14rpx
}

.required,
.field-error {
  color: #B83D49
}

.input,
.textarea,
.picker {
  border: 2rpx solid #C3DCEC;
  border-radius: 28rpx;
  background: #FCFEFF;
  box-shadow: inset 0 3rpx 7rpx rgba(57, 110, 143, .045), 0 2rpx 0 rgba(255, 255, 255, .8);
  width: 100%;
  padding: 24rpx;
  font-size: 16px;
  font-size: max(16px, 30rpx);
  color: #102D46
}

.picker {
  min-height: 48px
}

.input {
  height: 100rpx;
  min-height: 48px
}

.textarea {
  min-height: 380rpx;
  line-height: 1.7
}

.textarea.short {
  min-height: 220rpx;
  height: 240rpx
}

.field-hint {
  font-size: 24rpx;
  color: var(--ce-muted, #4D6E88);
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx
}

.counter {
  white-space: nowrap
}

.field-error {
  font-size: 26rpx;
  line-height: 1.6;
  margin: 16rpx 0
}

.sticky-actions {
  position: fixed;
  bottom: 12rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  background: linear-gradient(155deg, rgba(255, 255, 255, .94), rgba(222, 243, 255, .88));
  border: 2rpx solid rgba(255, 255, 255, .98);
  border-radius: 46rpx;
  box-shadow: 0 12rpx 34rpx rgba(31, 106, 153, .16), inset 0 3rpx 0 rgba(255, 255, 255, .98);
  padding: 22rpx;
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  z-index: 20
}

.sticky-actions>button {
  flex: 1;
  min-width: 0
}

.detail-title {
  font-size: 44rpx;
  line-height: 1.5;
  font-weight: 700;
  word-break: break-word;
  margin: 32rpx 0 20rpx
}

.detail-body {
  font-size: 32rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 32rpx
}

.review-content {
  padding: 26rpx;
  background: #fff;
  border: 2rpx solid #D5E4EE;
  border-radius: 36rpx;
  white-space: pre-wrap;
  line-height: 1.8;
  word-break: break-word
}

.book-cover {
  min-height: 240rpx;
  background: linear-gradient(150deg, #E9F7FF, #B8DBF4 65%, #DCF1FF);
  border-bottom: 2rpx solid #D5E4EE;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start
}

.book-cover.cyan {
  background: linear-gradient(150deg, #E9F8FF, #C5E8F8 65%, #EDF9FF)
}

.book-cover .icon {
  width: 56rpx;
  height: 56rpx
}

.book-cover-title {
  font-size: 32rpx;
  font-weight: 700
}

.book-info {
  padding: 20rpx
}

.resource-card {
  padding: 0;
  overflow: hidden;
  margin: 0
}

.resource-card .card-title {
  font-size: 28rpx;
  margin: 0 0 12rpx
}

.price {
  color: #0878BD;
  font-size: 32rpx;
  font-weight: 700
}

.demo {
  font-size: 23rpx;
  color: #446E85;
  background: #E8F3F9;
  border-radius: 10rpx;
  padding: 4rpx 12rpx
}

.ai-entry {
  background: linear-gradient(135deg, #F7FCFF, #D2EDFF);
  border-color: #fff;
  box-shadow: 0 8rpx 22rpx rgba(24, 122, 184, .12), inset 0 2rpx 0 #fff;
}

.radio-row {
  width: 100%;
  min-height: 50px;
  border: 2rpx solid #D5E4EE;
  background: white;
  border-radius: 30rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  color: #102D46
}

.radio-dot {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #9FB8CA;
  border-radius: 50%;
  flex: none;
  margin-left: 16rpx
}

.radio-row.active .radio-dot {
  border: 9rpx solid #0878BD;
  background: white
}

.checkline {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--ce-muted, #4D6E88);
  font-size: 26rpx;
  margin: 28rpx 0
}

.help-heading {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 0 12rpx;
  color: #102D46
}

.result-line {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin: 18rpx 0
}

.load-more {
  width: 100%;
  background: transparent;
  color: #0878BD;
  min-height: 48px
}

.status-block {
  margin: 24rpx 0
}

.reduced .primary,
.reduced .secondary,
.reduced .danger,
.reduced .chip,
.reduced .radio-row {
  transition: none
}

.reduced .press {
  transform: none
}

.sr-only {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0
}

/* Shared response and solid fallback for unsupported native WebViews. */
.between,
.toolbar,
.section-head,
.field-hint {
  flex-wrap: wrap
}

.list-link switch {
  flex-shrink: 0
}

.text-button,
.list-link,
.tile,
.search,
.load-more,
.radio-row {
  transition: transform 120ms cubic-bezier(.22, 1, .36, 1), opacity 120ms, background-color 160ms, color 160ms
}


.search .grow,
.list-link .grow,
.meta .grow {
  min-width: 0;
  word-break: break-word
}

@supports ((-webkit-backdrop-filter: blur(18px)) or (backdrop-filter: blur(18px))) {
  .search,
  .sticky-actions {
    background: linear-gradient(155deg, rgba(255, 255, 255, .66), rgba(211, 238, 255, .54));
    border-color: rgba(255, 255, 255, .98);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%)
  }
}

.solid .search,
.solid .sticky-actions {
  background: #fff;
  border-color: #C6DCEC;
  -webkit-backdrop-filter: none;
  backdrop-filter: none
}

.reduced .text-button,
.reduced .list-link,
.reduced .tile,
.reduced .search,
.reduced .load-more {
  transition: none
}


@media (prefers-reduced-motion: reduce) {
  .primary,
  .secondary,
  .danger,
  .chip,
  .radio-row,
  .text-button,
  .list-link,
  .tile,
  .search,
  .load-more {
    transition: none
  }
  .press {
    transform: none
  }
}

/* v2 component extensions. Reuse reading surfaces; only fixed interaction layers blur. */
.search-status {
  display: flex;
  align-items: center;
  flex: none;
  gap: 10rpx;
  border-left: 2rpx solid rgba(66, 123, 161, .18);
  padding-left: 20rpx;
}
.search-status .icon { width: 32rpx; height: 32rpx; }
.primary .button-icon { width: 34rpx; height: 34rpx; }
.section-title { color: #102E49; }
.profile-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 28rpx;
  border: 2rpx solid #fff;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #FBFEFF, #E1F1FD);
  box-shadow: 0 10rpx 28rpx rgba(39, 109, 154, .09), inset 0 2rpx 0 #fff;
}
.profile-summary .avatar { width: 104rpx; height: 104rpx; border-radius: 36rpx; font-size: 42rpx; }
.profile-name { font-size: 36rpx; font-weight: 700; line-height: 1.5; word-break: break-word; }
.profile-meta { margin-top: 8rpx; }
.function-group { padding: 0 24rpx; border-radius: 38rpx; background: #F9FCFF; border: 2rpx solid #fff; box-shadow: 0 10rpx 28rpx rgba(45, 106, 148, .07); }
.function-group .list-link { margin: 0; padding: 26rpx 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.function-group .list-link + .list-link { border-top: 2rpx solid #E0ECF4; }
.function-group .list-link .icon { padding: 8rpx; width: 56rpx; height: 56rpx; background: #E7F3FD; border: 2rpx solid #fff; border-radius: 18rpx; }
.radio-row.active { background: #DDF1FE; border-color: #7BBDE3; color: #18344F; box-shadow: inset 0 2rpx 0 #fff; }
.input:focus, .textarea:focus { border-color: #1689D5; }
.solid .chip:not(.active), .solid .secondary { background: #F9FCFF; border-color: #C6DCEC; }
@media (max-width: 350px) {
  .content { padding-left: 24rpx; padding-right: 24rpx; }
  .search-status { gap: 6rpx; padding-left: 12rpx; }
  .search-status .icon { display: none; }
}

/* v2 resilient reading and opaque accessibility surfaces. */
.meta { flex-wrap: wrap; }
.meta .tag { max-width:100%; overflow-wrap:anywhere; }
.solid .card,.solid .profile-summary,.solid .function-group,.solid .list-link,.solid .tile { background:#F9FCFF; border-color:#C6DCEC; }
.solid .input,.solid .textarea,.solid .picker { background:#fff; }
@media (prefers-reduced-transparency:reduce) {
 .search,.sticky-actions { background:#F9FCFF; -webkit-backdrop-filter:none; backdrop-filter:none; border-color:#C6DCEC; }
}

/* v2 secondary page composition: intro, form chapter and stable reading panel. */
.page-intro { display:flex;align-items:center;gap:24rpx;margin:0 0 32rpx;padding:16rpx 4rpx; }
.intro-icon { width:92rpx;height:92rpx;flex:none;display:flex;align-items:center;justify-content:center;border:2rpx solid #fff;border-radius:30rpx;background:linear-gradient(145deg,#F9FDFF,#CAE8FB);box-shadow:0 8rpx 18rpx rgba(40,116,162,.1),inset 0 2rpx #fff; }
.intro-icon image { width:44rpx;height:44rpx; }
.intro-title { font-size:44rpx;font-weight:750;line-height:1.4;color:#18344F;margin-bottom:10rpx; }
.form-panel,.reading-panel,.choice-panel,.help-panel { padding:30rpx;margin-bottom:28rpx;border:2rpx solid #fff;border-radius:42rpx;background:#F9FCFF;box-shadow:0 10rpx 28rpx rgba(45,106,148,.08),inset 0 2rpx #fff; }
.reading-panel { background:#FCFEFF;padding:34rpx; }
.panel-heading { display:flex;align-items:center;gap:20rpx;margin:0 0 28rpx; }
.section-number { width:60rpx;height:60rpx;flex:none;display:flex;align-items:center;justify-content:center;border-radius:20rpx;border:2rpx solid #fff;background:linear-gradient(145deg,#EDF9FF,#CEE9FB);color:#2B6B96;font-size:24rpx;font-weight:700; }
.panel-title { font-size:34rpx;font-weight:700;line-height:1.5; }
.section-caption { color:#486C86;font-size:24rpx;letter-spacing:2rpx;margin:4rpx 0 24rpx; }
.review-decision { margin-top:28rpx; }
.member-card .meta { margin-bottom:24rpx; }
.member-card .row { margin-top:28rpx; }
.member-decision { padding-top:24rpx;border-top:2rpx solid #DBEAF4; }
.choice-panel .label { margin-top:0; }
.preference-group { margin-bottom:32rpx; }
.help-panel .help-heading:first-child { margin-top:0; }
.solid .form-panel,.solid .reading-panel,.solid .choice-panel,.solid .help-panel { background:#fff;border-color:#C6DCEC; }
@media(max-width:350px) { .form-panel,.reading-panel,.choice-panel,.help-panel{padding:24rpx}.intro-title{font-size:42rpx}.panel-title{font-size:32rpx} }

.checkline { min-height:44px;align-items:center; }

/* v2.1 softer frosted interaction surfaces; no independent background strip. */
.search,.sticky-actions { box-shadow:0 8rpx 24rpx rgba(42,93,123,.065),inset 0 2rpx 2rpx rgba(255,255,255,.95); }
@supports ((-webkit-backdrop-filter:blur(18px)) or (backdrop-filter:blur(18px))) {
 .search,.sticky-actions { background:linear-gradient(145deg,rgba(255,255,255,.72),rgba(242,249,255,.56)); border-color:rgba(255,255,255,.88); -webkit-backdrop-filter:blur(18px) saturate(120%);backdrop-filter:blur(18px) saturate(120%); }
}
.solid .search,.solid .sticky-actions { background:#F9FCFF;-webkit-backdrop-filter:none;backdrop-filter:none;border-color:#C6DCEC; }
@media(prefers-reduced-transparency:reduce) { .search,.sticky-actions { background:#F9FCFF;-webkit-backdrop-filter:none;backdrop-filter:none; } }

/* v2.3 safe plain-text sections: identical in editor preview and public detail. */
.post-blocks{margin-top:32rpx;word-break:break-word}.post-block{white-space:pre-wrap;line-height:1.9;font-size:32rpx}.post-block.heading{font-size:35rpx;font-weight:700;margin:26rpx 0 16rpx;color:#18344F}.post-block.divider{color:#8CB4CE;letter-spacing:2rpx;margin:24rpx 0}.post-block.space{height:22rpx}.post-preview{min-height:420rpx}
