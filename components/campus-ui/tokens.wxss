/* Campus Echo Liquid Glass v2. Shared semantic tokens. */
page {
 --ce-ink:#18344F; --ce-muted:#4D6E88; --ce-primary:#0878BD;
 --ce-background:#DFEFFA; --ce-content:#F9FCFF; --ce-reading:#FCFEFF;
 --ce-glass:rgba(255,255,255,.66); --ce-glass-border:rgba(255,255,255,.96);
 --ce-danger:#A93546; --ce-success:#087D72; --ce-warning:#775A1E;
 --ce-radius-card:38rpx; --ce-radius-control:30rpx; --ce-radius-capsule:50rpx;
 --ce-space-page:32rpx; --ce-space-card:28rpx; --ce-space-stack:24rpx;
 --ce-font-title:50rpx; --ce-font-section:38rpx; --ce-font-body:30rpx; --ce-font-caption:26rpx;
 --ce-shadow-card:0 10rpx 28rpx rgba(45,106,148,.08),inset 0 2rpx 0 #fff;
 --ce-shadow-glass:0 12rpx 34rpx rgba(31,106,153,.16),inset 0 3rpx 0 rgba(255,255,255,.98);
 --ce-blur:18px; --ce-touch:44px;
 --ce-motion-press:60ms; --ce-motion-release:120ms; --ce-motion-filter:160ms;
 --ce-ease:cubic-bezier(.22,1,.36,1);
}
